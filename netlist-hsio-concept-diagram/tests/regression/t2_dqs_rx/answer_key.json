  "rx_en": {"class": "general_control", "function": "enables bias, DQ preamp/VGA tails and per-bit DQS local clock buffers"},
  "dqs_en": {"class": "general_control", "function": "enables DQS amp and C2C tails"},
  "vref_en": {"class": "general_control", "function": "enables VREFDQ ladder (header) and VREF buffer"},
  "vref_code<3:0>": {"class": "important_control", "function": "VREFDQ level: (40+code)/64 * VDDQ (0.625..0.859 VDDQ)"},
  "vga_gain<2:0>": {"class": "important_control", "function": "VGA gain code shared by all 8 bits (switches parallel degeneration R 4k/2k/1k)"},
  "wdca<3:0>": {"class": "important_control", "function": "WDCA duty adjust: <3> sign (1 = widen DQS_t high), <2:0> magnitude (1/2/4 weighted skew legs)"},
  "wdca_en": {"class": "general_control", "function": "WDCA enable (0 = no skew legs active)"},
  "dq_r<7:0>": {"class": "hs_data_out", "function": "per-bit data sampled on DQS_t rising edge (even)"},
  "dq_f<7:0>": {"class": "hs_data_out", "function": "per-bit data sampled on DQS_c rising edge = DQS_t falling (odd)"},
  "vdd": {"class": "power", "function": "0.8 V core supply"},
  "vddq": {"class": "power", "function": "1.1 V IO supply"},
  "vss": {"class": "power", "function": "ground"}
 },
