    ["mp1.d", "PORT.qb", "qb", "data"]
   ],
   "controls": {},
   "notes": "used with ck/ckb pins swapped as a transparent-low latch in ser4to1; also inside icg_x1. [direct primitives in this cell: 8 MOS]"
  },
  "mux2_x1": {
   "role": "2:1 transmission-gate mux (y = s ? b : a)",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [],
