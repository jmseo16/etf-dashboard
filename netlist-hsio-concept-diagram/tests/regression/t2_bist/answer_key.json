{
 "top": "hsio_bist_top",
 "supplies": [
  "vdd",
  "vddq"
 ],
 "grounds": [
  "vss"
 ],
 "ports": {
  "ckp": {"class": "clock_in", "function": "4 GHz half-rate differential clock, true (AC-coupled into ck_rx_acbuf)"},
  "ckn": {"class": "clock_in", "function": "half-rate differential clock, complement"},
  "rxp": {"class": "hs_data_in", "function": "external RX pad P (8 Gb/s), 50 Ohm terminated, selected when lpbk_en=0"},
  "rxn": {"class": "hs_data_in", "function": "external RX pad N"},
  "txp": {"class": "hs_data_out", "function": "CML TX pad P (PRBS out); also tapped internally as loopback source"},
  "txn": {"class": "hs_data_out", "function": "CML TX pad N; also loopback source"},
  "ibias": {"class": "bias", "function": "100 uA reference current into bist_bias diode -> vbn for all CML tails"},
  "rstb": {"class": "general_control", "function": "global active-low async reset; seeds LFSR to 0..01, clears registers"},
  "bist_en": {"class": "general_control", "function": "bias enable (vbn pulled to vss when 0)"},
  "bist_start": {"class": "important_control", "function": "BIST start request (sync to wclk, rising edge): sets RUN, clears counters/lock"},
  "bist_stop": {"class": "important_control", "function": "BIST stop request (sync to wclk): clears RUN, sets DONE"},
  "cfg<8:0>": {"class": "important_control", "function": "mode register data: <8> prbs_sel(1=PRBS15) <7> lpbk_en <6> tx_en <5> rx_en <4> chk_en <3> err_inj <2:0> rdly (RX clock delay trim)"},
  "cfg_wr": {"class": "general_control", "function": "mode register write strobe (rising edge loads cfg<8:0>)"},
  "err_cnt<9:0>": {"class": "test_digital", "function": "error-word count after lock (10b ripple counter)"},
  "err_ovf": {"class": "test_digital", "function": "sticky error counter overflow"},
  "bist_lock": {"class": "test_digital", "function": "checker lock (>=15 consecutive error-free words)"},
  "bist_err": {"class": "test_digital", "function": "registered per-word error flag from PRBS checker"},
  "bist_busy": {"class": "test_digital", "function": "RUN state"},
  "bist_done": {"class": "test_digital", "function": "DONE state (set by stop after run)"},
  "vdd": {"class": "power", "function": "0.9 V core supply"},
  "vddq": {"class": "power", "function": "1.0 V CML/TX/RX analog supply"},
  "vss": {"class": "power", "function": "ground"}
 },
 "cells": {
  "hsio_bist_top": {
   "role": "HSIO loopback BIST top",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [
    {"inst": "xi0", "cell": "bist_bias", "role": "CML tail bias generator (current-reference diode + RC filter)"},
    {"inst": "xi1", "cell": "bist_clkgen", "role": "clock generation: clock RX buffer, /2 word clock divider, RX clock delay trim"},
    {"inst": "xi2", "cell": "mode_reg", "role": "9-bit BIST mode register (parallel load)"},
    {"inst": "xi3", "cell": "bist_ctrl", "role": "BIST control FSM (start/stop, run/done, error-inject pulse, counter clear)"},
    {"inst": "xi4", "cell": "prbs_gen", "role": "4-bit/word parallel PRBS7/PRBS15 generator (LFSR) with error injection"},
    {"inst": "xi5", "cell": "bist_tx_hs", "role": "TX high-speed path: serializer + CML driver"},
    {"inst": "xi6", "cell": "lpbk_mux", "role": "RX termination + CML 2:1 loopback select mux"},
    {"inst": "xi7", "cell": "bist_rx_hs", "role": "RX high-speed path: CTLE + even/odd samplers + deserializer"},
    {"inst": "xi8", "cell": "prbs_chk", "role": "self-synchronizing PRBS7/PRBS15 checker + error detector"},
    {"inst": "xi9", "cell": "lock_det4", "role": "lock detector: 4-bit saturating counter of consecutive error-free words"},
    {"inst": "xi10", "cell": "err_cnt10", "role": "10-bit ripple error counter with sticky overflow"}
   ],
   "signal_flow": [
    ["PORT.ckp", "xi1.ckp", "ckp", "clock"],
    ["PORT.ckn", "xi1.ckn", "ckn", "clock"],
    ["xi1.ck", "xi5.ck", "ck", "clock"],
    ["xi1.ckb", "xi5.ckb", "ckb", "clock"],
    ["xi1.wclk", "xi4.wclk", "wclk", "clock"],
    ["xi1.wclk", "xi5.wclk", "wclk", "clock"],
    ["xi1.wclkb", "xi5.wclkb", "wclkb", "clock"],
    ["xi1.wclk", "xi3.wclk", "wclk", "clock"],
    ["xi1.rck", "xi7.rck", "rck", "clock"],
    ["xi1.rckb", "xi7.rckb", "rckb", "clock"],
    ["xi4.tx_d<3>", "xi5.tx_d<3>", "tx_d<3>", "word_data"],
    ["xi4.tx_d<2>", "xi5.tx_d<2>", "tx_d<2>", "word_data"],
    ["xi4.tx_d<1>", "xi5.tx_d<1>", "tx_d<1>", "word_data"],
    ["xi4.tx_d<0>", "xi5.tx_d<0>", "tx_d<0>", "word_data"],
    ["xi5.txp", "PORT.txp", "txp", "hs_data"],
    ["xi5.txn", "PORT.txn", "txn", "hs_data"],
    ["PORT.txp", "xi6.txp", "txp", "hs_data"],
    ["PORT.txn", "xi6.txn", "txn", "hs_data"],
    ["PORT.rxp", "xi6.rxp", "rxp", "hs_data"],
    ["PORT.rxn", "xi6.rxn", "rxn", "hs_data"],
    ["xi6.rxi_p", "xi7.rxi_p", "rxi_p", "hs_data"],
    ["xi6.rxi_n", "xi7.rxi_n", "rxi_n", "hs_data"],
    ["xi7.rx_d<3>", "xi8.rx_d<3>", "rx_d<3>", "word_data"],
    ["xi7.rx_d<2>", "xi8.rx_d<2>", "rx_d<2>", "word_data"],
    ["xi7.rx_d<1>", "xi8.rx_d<1>", "rx_d<1>", "word_data"],
    ["xi7.rx_d<0>", "xi8.rx_d<0>", "rx_d<0>", "word_data"],
    ["xi7.rwclk", "xi8.rwclk", "rwclk", "clock"],
    ["xi7.rwclk", "xi9.rwclk", "rwclk", "clock"],
    ["xi7.rwclkb", "xi10.rwclkb", "rwclkb", "clock"],
    ["xi8.err_q", "xi9.err_q", "bist_err", "status"],
    ["xi8.err_q", "xi10.err_q", "bist_err", "status"],
    ["xi8.err_q", "PORT.bist_err", "bist_err", "status"],
    ["xi8.run_s", "xi9.run_s", "run_s", "control"],
    ["xi8.run_s", "xi10.run_s", "run_s", "control"],
    ["xi9.lock", "xi10.lock", "bist_lock", "status"],
    ["xi9.lock", "PORT.bist_lock", "bist_lock", "status"],
    ["xi10.cnt<9>", "PORT.err_cnt<9>", "err_cnt<9>", "status"],
    ["xi10.cnt<0>", "PORT.err_cnt<0>", "err_cnt<0>", "status"],
    ["xi10.ovf", "PORT.err_ovf", "err_ovf", "status"],
    ["PORT.ibias", "xi0.ibias", "ibias", "bias"],
    ["xi0.vbn", "xi5.vbn", "vbn", "bias"],
    ["xi0.vbn", "xi6.vbn", "vbn", "bias"],
    ["xi0.vbn", "xi7.vbn", "vbn", "bias"],
    ["PORT.cfg<8>", "xi2.cfg<8>", "cfg<8>", "control"],
    ["PORT.cfg_wr", "xi2.cfg_wr", "cfg_wr", "control"],
    ["xi2.prbs_sel", "xi4.prbs_sel", "prbs_sel", "control"],
    ["xi2.prbs_sel", "xi8.prbs_sel", "prbs_sel", "control"],
    ["xi2.lpbk_en", "xi6.lpbk_en", "lpbk_en", "control"],
    ["xi2.tx_en", "xi5.tx_en", "tx_en", "control"],
    ["xi2.tx_en", "xi3.tx_en", "tx_en", "control"],
    ["xi2.rx_en", "xi7.rx_en", "rx_en", "control"],
    ["xi2.chk_en", "xi3.chk_en", "chk_en", "control"],
    ["xi2.err_inj", "xi3.err_inj", "err_inj", "control"],
    ["xi2.rdly<2>", "xi1.rdly<2>", "rdly<2>", "control"],
    ["xi2.rdly<0>", "xi1.rdly<0>", "rdly<0>", "control"],
    ["PORT.bist_start", "xi3.bist_start", "bist_start", "control"],
    ["PORT.bist_stop", "xi3.bist_stop", "bist_stop", "control"],
    ["xi3.gen_run", "xi4.gen_run", "gen_run", "control"],
    ["xi3.inj_p", "xi4.inj", "inj_p", "control"],
    ["xi3.chk_run", "xi8.chk_run", "chk_run", "control"],
    ["xi3.clr_b", "xi9.clr_b", "clr_b", "control"],
    ["xi3.clr_b", "xi10.clr_b", "clr_b", "control"],
    ["xi3.bist_busy", "PORT.bist_busy", "bist_busy", "status"],
    ["xi3.bist_done", "PORT.bist_done", "bist_done", "status"]
   ],
   "controls": {
    "cfg<8:0>": "mode register contents (prbs_sel, lpbk_en, tx_en, rx_en, chk_en, err_inj, rdly<2:0>)",
    "cfg_wr": "mode register write strobe",
    "bist_start": "start BIST run",
    "bist_stop": "stop BIST run",
    "bist_en": "bias enable",
    "rstb": "global async reset",
    "prbs_sel": "PRBS7 (0) / PRBS15 (1) for generator and checker",
    "lpbk_en": "internal TX->RX loopback (1) vs external rxp/rxn (0)",
    "tx_en": "TX driver tail enable and generator run qualifier",
    "rx_en": "CTLE tail enable",
    "chk_en": "checker run qualifier",
    "err_inj": "0->1 injects one bit error on tx_d<0>",
    "rdly<2:0>": "RX sampling clock delay trim (switched caps)"
   },
   "notes": "HS path: prbs_gen(xi4, word rate) -> bist_tx_hs(xi5: 4:1 serializer + CML driver) -> txp/txn pads -> lpbk_mux(xi6, loopback tap or rxp/rxn) -> bist_rx_hs(xi7: CTLE, even/odd StrongARM samplers, 1:4 deser) -> prbs_chk(xi8) -> lock_det4(xi9), err_cnt10(xi10). TX side runs on wclk (=ck/2), RX side on rwclk (=rck/2, its own divider). xi0 bias, xi1 clocks, xi2 mode register, xi3 control are not on the data path. Loopback path is analog (TX pad -> 200 Ohm -> mux), not a digital bypass. [direct primitives in this cell: 2 C]"
  },
  "bist_clkgen": {
   "role": "clock generation: clock RX buffer, /2 word clock divider, RX clock delay trim",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [
    {"inst": "xi0", "cell": "ck_rx_acbuf", "role": "AC-coupled self-biased inverter clock receiver (CML -> CMOS)"},
    {"inst": "xi1", "cell": "inv_x4", "role": "clock buffer inverter (x4)"},
    {"inst": "xi2", "cell": "inv_x4", "role": "clock buffer inverter (x4)"},
    {"inst": "xi3", "cell": "dffr_x1", "role": "positive-edge DFF with active-low async reset"},
    {"inst": "xi4", "cell": "inv_x4", "role": "clock buffer inverter (x4)"},
    {"inst": "xi5", "cell": "inv_x4", "role": "clock buffer inverter (x4)"},
    {"inst": "xi6", "cell": "rxck_dly", "role": "RX sampling-clock delay trim (two dly_cell paths)"}
   ],
   "signal_flow": [
    ["PORT.ckp", "xi0.ckp", "ckp", "clock"],
    ["PORT.ckn", "xi0.ckn", "ckn", "clock"],
    ["xi0.ck", "xi2.a", "ck_i", "clock"],
    ["xi0.ckb", "xi1.a", "ckb_i", "clock"],
    ["xi1.y", "PORT.ck", "ck", "clock"],
    ["xi2.y", "PORT.ckb", "ckb", "clock"],
    ["PORT.ck", "xi3.ck", "ck", "clock"],
    ["xi3.qb", "xi3.d", "wclkb_i", "clock"],
    ["xi3.q", "xi5.a", "wclk_i", "clock"],
    ["xi3.qb", "xi4.a", "wclkb_i", "clock"],
    ["xi4.y", "PORT.wclk", "wclk", "clock"],
    ["xi5.y", "PORT.wclkb", "wclkb", "clock"],
    ["PORT.ck", "xi6.ck", "ck", "clock"],
    ["PORT.ckb", "xi6.ckb", "ckb", "clock"],
    ["xi6.rck", "PORT.rck", "rck", "clock"],
    ["xi6.rckb", "PORT.rckb", "rckb", "clock"]
   ],
   "controls": {
    "rdly<2:0>": "delay of rck/rckb vs ck/ckb (RX sampling phase)",
    "rstb": "resets the /2 divider"
   },
   "notes": "ck is produced by inverting ckb_i (and ckb from ck_i) so polarity of ck follows ckp. xi3 is a DFF with D=QB used as divide-by-2 (feedback loop). wclk = ck/2 is the TX word clock."
  },
  "ck_rx_acbuf": {
   "role": "AC-coupled self-biased inverter clock receiver (CML -> CMOS)",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [],
   "signal_flow": [
    ["PORT.ckp", "c0.p", "ckp", "clock"],
    ["c0.n", "mp0.g", "net1", "clock"],
    ["mp0.d", "mp4.g", "net3", "clock"],
    ["mp4.d", "PORT.ck", "ck", "clock"],
    ["PORT.ckn", "c1.p", "ckn", "clock"],
    ["c1.n", "mp1.g", "net2", "clock"],
    ["mp1.d", "mp5.g", "net4", "clock"],
    ["mp5.d", "PORT.ckb", "ckb", "clock"]
   ],
   "controls": {},
   "notes": "20k feedback resistors self-bias the first inverters at trip point; mp2/mn2/mp3/mn3 weak cross-coupled inverters force complementary phases. Two inversions per rail -> non-inverting. [direct primitives in this cell: 2 C, 12 MOS, 2 R]"
  },
  "inv_x4": {
   "role": "clock buffer inverter (x4)",
   "on_high_speed_path": true,
   "inverting": true,
   "children": [],
   "signal_flow": [
    ["PORT.a", "mp0.g", "a", "clock"],
    ["mp0.d", "PORT.y", "y", "clock"]
   ],
   "controls": {},
   "notes": "used as clock buffer in bist_clkgen, rxck_dly, rx_deser [direct primitives in this cell: 2 MOS]"
  },
  "dly_cell": {
   "role": "digitally controlled delay stage (2 inverters + binary-weighted switched caps)",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [],
   "signal_flow": [
    ["PORT.in", "mp0.g", "in", "clock"],
    ["mp0.d", "mp1.g", "n1", "clock"],
    ["mp1.d", "PORT.out", "out", "clock"]
   ],
   "controls": {
    "c<2:0>": "switch 3f/6f/12f load caps onto internal node n1 (more code = more delay)"
   },
   "notes": "[direct primitives in this cell: 3 C, 7 MOS]"
  },
  "rxck_dly": {
   "role": "RX sampling-clock delay trim (two dly_cell paths)",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [
    {"inst": "xi0", "cell": "dly_cell", "role": "digitally controlled delay stage (2 inverters + binary-weighted switched caps)"},
    {"inst": "xi1", "cell": "dly_cell", "role": "digitally controlled delay stage (2 inverters + binary-weighted switched caps)"},
    {"inst": "xi2", "cell": "inv_x4", "role": "clock buffer inverter (x4)"},
    {"inst": "xi3", "cell": "inv_x4", "role": "clock buffer inverter (x4)"}
   ],
   "signal_flow": [
    ["PORT.ck", "xi0.in", "ck", "clock"],
    ["xi0.out", "xi3.a", "dp", "clock"],
    ["PORT.ckb", "xi1.in", "ckb", "clock"],
    ["xi1.out", "xi2.a", "dn", "clock"],
    ["xi2.y", "PORT.rck", "rck", "clock"],
    ["xi3.y", "PORT.rckb", "rckb", "clock"]
   ],
   "controls": {
    "rdly<2:0>": "shared delay code for both phases"
   },
   "notes": "rck is the inverted delayed ckb path (dn), rckb the inverted delayed ck path (dp) -> rck has ck polarity. mp0/mn0/mp1/mn1 weak cross-coupling between dp and dn. [direct primitives in this cell: 4 MOS]"
  },
  "dffr_x1": {
   "role": "positive-edge DFF with active-low async reset",
   "on_high_speed_path": false,
   "inverting": false,
   "children": [],
   "signal_flow": [
    ["PORT.d", "mn0.s", "d", "data"],
    ["mp6.d", "PORT.q", "q", "data"]
   ],
   "controls": {},
   "notes": "generic flop; on the clock path only where wired as /2 divider (bist_clkgen.xi3, rx_deser.xi4); TFF in err_cnt10. [direct primitives in this cell: 22 MOS]"
  },
  "dff_x1": {
   "role": "positive-edge master-slave DFF (no reset)",
