    ["mn1.d", "PORT.y", "y", "data"]
   ],
   "controls": {
    "s": "select"
   },
   "notes": "HS use: 4:2 stage of ser4to1 (s=wclk). Also used in prbs_pred4 (not HS). [direct primitives in this cell: 6 MOS]"
  },
  "ser4to1": {
   "role": "4:1 half-rate serializer (CMOS 4:2 at wclk + CML 2:1 at ck)",
   "on_high_speed_path": true,
   "inverting": false,
   "children": [
    {"inst": "xi0<3:0>", "cell": "dff_x1", "role": "positive-edge master-slave DFF (no reset)"},
    {"inst": "xi1<1:0>", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi2<1:0>", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi3<1:0>", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi4", "cell": "mux2_x1", "role": "2:1 transmission-gate mux (y = s ? b : a)"},
    {"inst": "xi5", "cell": "mux2_x1", "role": "2:1 transmission-gate mux (y = s ? b : a)"},
    {"inst": "xi6", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi7", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi8", "cell": "dlat_x1", "role": "D latch, transparent when ck=1 (complement clock on ckb pin)"},
    {"inst": "xi9", "cell": "ser_mux2_cml", "role": "CML 2:1 clock-selected mux (final serializer stage)"}
   ],
   "signal_flow": [
    ["PORT.d<0>", "xi0<0>.d", "d<0>", "word_data"],
    ["PORT.d<1>", "xi0<1>.d", "d<1>", "word_data"],
    ["PORT.d<2>", "xi0<2>.d", "d<2>", "word_data"],
    ["PORT.d<3>", "xi0<3>.d", "d<3>", "word_data"],
