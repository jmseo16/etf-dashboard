    ["xi0<2>.q", "xi2<0>.d", "dr<2>", "word_data"],
    ["xi2<0>.q", "xi3<0>.d", "net042<0>", "word_data"],
    ["xi3<0>.q", "xi4.a", "a2h", "word_data"],
    ["xi0<1>.q", "xi1<1>.d", "dr<1>", "word_data"],
    ["xi1<1>.q", "xi5.b", "b1l", "word_data"],
    ["xi0<3>.q", "xi2<1>.d", "dr<3>", "word_data"],
    ["xi2<1>.q", "xi3<1>.d", "net042<1>", "word_data"],
    ["xi3<1>.q", "xi5.a", "b3h", "word_data"],
    ["xi4.y", "xi6.d", "sa", "hs_data"],
    ["xi6.q", "xi9.a", "sar", "hs_data"],
    ["xi6.qb", "xi9.ab", "sarb", "hs_data"],
    ["xi5.y", "xi7.d", "sb", "hs_data"],
    ["xi7.q", "xi8.d", "net045", "hs_data"],
    ["xi8.q", "xi9.b", "sbr", "hs_data"],
    ["xi8.qb", "xi9.bb", "sbrb", "hs_data"],
    ["xi9.op", "PORT.txs", "txs", "hs_data"],
    ["xi9.on", "PORT.txsb", "txsb", "hs_data"],
    ["PORT.wclk", "xi0<0>.ck", "wclk", "clock"],
    ["PORT.wclk", "xi4.s", "wclk", "clock"],
    ["PORT.wclk", "xi5.s", "wclk", "clock"],
    ["PORT.ckb", "xi6.ck", "ckb", "clock"],
    ["PORT.ck", "xi8.ck", "ck", "clock"],
    ["PORT.ck", "xi9.ck", "ck", "clock"],
    ["PORT.ckb", "xi9.ckb", "ckb", "clock"],
    ["PORT.vbn", "xi9.vbn", "vbn", "bias"]
   ],
   "controls": {},
   "notes": "Even stream = d<0>,d<2> (mux xi4), odd stream = d<1>,d<3> (mux xi5). Latches xi1 (transparent-low on wclk), xi2+xi3 (low then high) align inputs so each mux input is stable while selected; xi6 (transparent-low on ck) and xi7+xi8 (low then high) re-time the half-rate streams for the CML mux. Serial bit order: d<0>, d<1>, d<2>, d<3>. Unused flop/latch qb outputs (net040..net046)."
  },
