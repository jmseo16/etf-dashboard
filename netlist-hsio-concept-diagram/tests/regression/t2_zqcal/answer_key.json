{
 "top": "zqcal_top",
 "supplies": [
  "vdd",
  "vddq"
 ],
 "grounds": [
  "vss"
 ],
 "ports": {
  "zq": {"class": "slow_signal", "function": "ZQ pad (analog); external RZQ=240 Ohm to VSS; driven by PU replica array during PU calibration"},
  "ibias_zq": {"class": "bias", "function": "10 uA reference current -> comparator preamp tail bias"},
  "zq_clk": {"class": "clock_in", "function": "calibration FSM clock (~200 MHz); /8 prescaler gives step_clk"},
  "zq_start": {"class": "important_control", "function": "ZQ calibration start command (synchronized, edge-detected, ignored while busy)"},
  "zq_latch": {"class": "important_control", "function": "ZQ latch command: copies SAR results to pu_code/pd_code (only when zq_done=1)"},
  "rstb": {"class": "general_control", "function": "active-low async reset; output codes reset to 100000"},
  "vref_trim<1:0>": {"class": "general_control", "function": "VREF tap select: 00=15/32, 01=16/32 (VDDQ/2), 10=17/32, 11=18/32 VDDQ"},
  "pu_code<5:0>": {"class": "slow_signal", "function": "calibrated pull-up code to DQ drivers (binary, 1=leg on, weights 32..1 over 32-unit base)"},
  "pd_code<5:0>": {"class": "slow_signal", "function": "calibrated pull-down code to DQ drivers"},
  "zq_busy": {"class": "slow_signal", "function": "calibration in progress (also analog enable)"},
  "zq_done": {"class": "slow_signal", "function": "calibration complete (sticky until next start)"},
  "zq_cmp_mon": {"class": "test_digital", "function": "comparator decision monitor (same net feeds both SARs)"},
  "vdd": {"class": "power", "function": "0.8 V core supply"},
  "vddq": {"class": "power", "function": "1.1 V IO supply"},
  "vss": {"class": "power", "function": "ground"}
 },
 "cells": {
  "zqcal_top": {
   "role": "ZQ calibration engine top",
   "on_high_speed_path": false,
   "inverting": null,
   "children": [
    {"inst": "xi0", "cell": "zq_fsm", "role": "calibration FSM/timer: /8 prescaler, start sync, busy/done, 15-stage one-hot sequencer"},
    {"inst": "xi1", "cell": "zq_sar6", "role": "6-bit SAR register (successive approximation)"},
    {"inst": "xi2", "cell": "zq_sar6", "role": "6-bit SAR register (successive approximation)"},
    {"inst": "xi3", "cell": "zq_code_reg", "role": "DQ driver code output registers"},
    {"inst": "xi4", "cell": "zq_vref_gen", "role": "VREF generator (VDDQ/2 ladder + 2b trim mux + RC filter)"},
    {"inst": "xi5", "cell": "zq_pu_cal_path", "role": "pull-up calibration branch: predriver + PU replica array on ZQ pad + pad ESD/sense"},
    {"inst": "xi6", "cell": "zq_pd_cal_path", "role": "pull-down calibration branch: replica PU (pu code) over replica PD (pd code) -> npd"},
    {"inst": "xi7", "cell": "zq_cmp_top", "role": "comparator subsystem: bias + input crossbar + comparator"}
   ],
   "signal_flow": [
    ["PORT.zq_clk", "xi0.zq_clk", "zq_clk", "clock"],
    ["PORT.zq_start", "xi0.zq_start", "zq_start", "control"],
    ["xi0.step_clk", "xi1.ck", "step_clk", "clock"],
    ["xi0.step_clk", "xi2.ck", "step_clk", "clock"],
    ["xi0.w1", "xi1.t<6>", "w1", "control"],
    ["xi0.tu<5>", "xi1.t<5>", "tu<5>", "control"],
    ["xi0.tu<0>", "xi1.t<0>", "tu<0>", "control"],
    ["xi0.tu<0>", "xi2.t<6>", "tu<0>", "control"],
    ["xi0.td<5>", "xi2.t<5>", "td<5>", "control"],
    ["xi0.td<0>", "xi2.t<0>", "td<0>", "control"],
    ["xi0.cmp_clk", "xi7.cmp_clk", "cmp_clk", "clock"],
    ["xi0.en_pu", "xi5.en_pu", "en_pu", "control"],
    ["xi0.en_pd", "xi6.en_pd", "en_pd", "control"],
    ["xi0.en_pd", "xi7.ph_pd", "en_pd", "control"],
    ["xi0.busy", "xi4.en", "zq_busy", "control"],
    ["xi0.busy", "xi7.en", "zq_busy", "control"],
    ["xi0.busy", "PORT.zq_busy", "zq_busy", "status"],
    ["xi0.zq_done", "xi3.zq_done", "zq_done", "status"],
    ["xi0.zq_done", "PORT.zq_done", "zq_done", "status"],
    ["xi1.b<5>", "xi5.pu_b<5>", "pu_b<5>", "code"],
    ["xi1.b<5>", "xi6.pu_b<5>", "pu_b<5>", "code"],
    ["xi1.b<5>", "xi3.pu_b<5>", "pu_b<5>", "code"],
    ["xi2.b<5>", "xi6.pd_b<5>", "pd_b<5>", "code"],
    ["xi2.b<5>", "xi3.pd_b<5>", "pd_b<5>", "code"],
    ["PORT.zq", "xi5.zq", "zq", "analog"],
    ["xi5.zq_s", "xi7.zq_s", "zq_s", "analog"],
    ["xi6.npd", "xi7.npd", "npd", "analog"],
    ["xi4.vref", "xi7.vref", "vref", "analog"],
    ["PORT.vref_trim<1>", "xi4.vref_trim<1>", "vref_trim<1>", "control"],
    ["PORT.ibias_zq", "xi7.ibias", "ibias_zq", "bias"],
    ["xi7.cmp_q", "xi1.cmp", "zq_cmp_mon", "decision"],
    ["xi7.cmp_q", "xi2.cmp", "zq_cmp_mon", "decision"],
    ["xi7.cmp_q", "PORT.zq_cmp_mon", "zq_cmp_mon", "decision"],
    ["PORT.zq_latch", "xi3.zq_latch", "zq_latch", "control"],
    ["xi3.pu_code<5>", "PORT.pu_code<5>", "pu_code<5>", "code"],
    ["xi3.pd_code<0>", "PORT.pd_code<0>", "pd_code<0>", "code"]
   ],
   "controls": {
    "zq_start": "start calibration",
    "zq_latch": "transfer codes to DQ driver registers",
    "vref_trim<1:0>": "comparator reference level",
    "en_pu": "pad PU replica enable (busy and not PD phase)",
    "en_pd": "PD phase: replica PU+PD branch enable and comparator input swap",
    "pu_b<5:0>": "working PU SAR code (drives both PU replica arrays)",
    "pd_b<5:0>": "working PD SAR code (drives PD replica array)"
   },
   "notes": "Closed mixed-signal loop: SAR code -> predriver -> replica array -> zq/npd node -> comparator -> SAR. PU calibrated first (tu<5:0>), then PD (td<5:0>) using the calibrated PU code on the replica PU array. No high-speed path in this block. [direct primitives in this cell: 2 C]"
  },
  "zq_fsm": {
   "role": "calibration FSM/timer: /8 prescaler, start sync, busy/done, 15-stage one-hot sequencer",
   "on_high_speed_path": false,
   "inverting": null,
   "children": [
    {"inst": "xi0", "cell": "dffr_d1", "role": "positive-edge DFF with active-low async reset"},
    {"inst": "xi1", "cell": "dffr_d1", "role": "positive-edge DFF with active-low async reset"},
