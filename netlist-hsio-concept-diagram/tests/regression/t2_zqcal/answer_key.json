    {"inst": "xi18", "cell": "inv_d1", "role": "inverter"},
    {"inst": "xi19", "cell": "or2_d1", "role": "OR2 (nor2 + inv)"},
    {"inst": "xi20", "cell": "and2_d1", "role": "AND2 (nand2 + inv)"},
    {"inst": "xi21", "cell": "dffr_d1", "role": "positive-edge DFF with active-low async reset"},
    {"inst": "xi22", "cell": "nor3_d1", "role": "NOR3"},
    {"inst": "xi23", "cell": "nor3_d1", "role": "NOR3"},
